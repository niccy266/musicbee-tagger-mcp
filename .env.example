# MusicBee Tagger MCP — HTTPS Docker environment
# Copy this file to .env and edit before running `docker compose up -d`.

# Local folder containing your audio files (mounted read-only into the MCP
# container, read-write into the apply container).
MUSICBEE_AUDIO_DIR=/path/to/your/audio

# HTTPS port exposed on localhost for Claude Desktop.
MCP_HTTPS_PORT=8443

# Secret token required to trigger the apply agent via docker compose exec.
# Used as a basic authorization check for the secret apply command.
SECRET_COMMAND_TOKEN=change-me-to-a-strong-secret

# Data directory inside containers (registrations, queue, state).
# Usually left as /data.
MUSICBEE_TAGGER_DATA_DIR=/data