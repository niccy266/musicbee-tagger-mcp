# MusicBee Tagger MCP — Tailscale-connected HTTPS service
# Copy to .env and replace all placeholder secrets before starting Compose.

# Local folder containing audio files (read-only in MCP, read-write in apply).
MUSICBEE_AUDIO_DIR=/path/to/your/audio

# Tailscale auth key for the persistent sidecar.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Required Bearer token for MCP requests. Generate a long random value.
MCP_AUTH_TOKEN=replace-with-a-long-random-secret

# Optional localhost port mapping for local testing.
MCP_HTTPS_PORT=8443

# Secret token required to trigger the apply agent via docker compose exec.
SECRET_COMMAND_TOKEN=change-me-to-a-strong-secret

# Data directory inside containers (registrations, queue, state).
MUSICBEE_TAGGER_DATA_DIR=/data
